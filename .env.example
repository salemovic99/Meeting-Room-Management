# Copy to .env and fill in. Never commit .env.

APP_ENV=production
APP_URL=https://meetings.company.com
FRONTEND_URL=https://meetings.company.com
# Only needed if the frontend is served from a different origin than the API.
CORS_ORIGINS=
LOG_LEVEL=INFO
TIMEZONE=Asia/Riyadh

POSTGRES_DB=mrm
POSTGRES_USER=mrm
POSTGRES_PASSWORD=
# Set by docker-compose for the backend container; set it yourself when running outside Docker.
# DATABASE_URL=postgresql+asyncpg://mrm:password@localhost:5432/mrm

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
DEVICE_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
DISPLAY_TOKEN_EXPIRE_MINUTES=15
COOKIE_SECURE=true

LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900

# First super admin, created by the seed on startup if it doesn't exist. Change the password after first login.
SEED_ADMIN_EMAIL=admin@company.com
SEED_ADMIN_PASSWORD=

# Backups (infrastructure/scripts/backup.sh)
BACKUP_RETENTION_DAYS=30
# Optional: encrypt dumps with this passphrase (openssl AES-256). Strongly recommended.
BACKUP_ENCRYPTION_KEY=
